# Copy to .env.production for compose.production.yaml, or use these names with
# a custom hosting deployment. The production Compose file is standalone.
# Never commit the real values.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_HEALTHCHECK_HOST=app.example.com
DJANGO_TIME_ZONE=Asia/Manila
# Human inactivity deadline and frontend warning lead time, in seconds.
AUTH_IDLE_TIMEOUT_SECONDS=900
AUTH_IDLE_WARNING_SECONDS=60
BACKEND_IMAGE=rosario-dairy-backend:production
FRONTEND_IMAGE=rosario-dairy-frontend:local
API_PORT=8000
FRONTEND_PORT=5173

# Fresh bundled PostgreSQL only: distinct administrator, migration and runtime
# users. Give each a different random password with at least 20 characters.
POSTGRES_ADMIN_USER=rosario_owner
POSTGRES_ADMIN_PASSWORD=replace-with-a-unique-administrator-password
MIGRATION_DB_USER=rosario_migrate
MIGRATION_DB_PASSWORD=replace-with-a-unique-migration-password

DB_NAME=rosario_dairy
# Dedicated runtime role: NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION
# NOBYPASSRLS; grant only the application schema/table/sequence access it needs.
# Migration and isolated SQL-backup verification credentials are separate.
DB_USER=rosario_app
DB_PASSWORD=replace-with-a-unique-application-password
DB_HOST=db
DB_PORT=5432
# Per-host connection establishment timeout; does not limit query execution.
DB_CONNECT_TIMEOUT=5
# Bundled Redis is private to the production Compose network. For a custom
# deployment using managed Redis, supply its complete provider URL instead.
REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_BEHIND_HTTPS_PROXY=true
# Explicit opt-in: the proxy must strip incoming X-Forwarded-Proto, supply its
# own value and prevent clients from reaching the application directly.
# The provided production proxy chain overwrites X-Forwarded-For at the public
# edge with one client IP and preserves that canonical value at inner hops.
# Custom deployments that append addresses must set the actual trusted count.
DJANGO_NUM_PROXIES=1
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
# Production rejects disabled HTTPS redirects/secure cookies, nonpositive HSTS,
# wildcard hosts and configured browser origins that are not explicit HTTPS.
# Validate effective role flags: python manage.py check --deploy --database default

# Any SMTP provider works. For a Gmail sender, use smtp.gmail.com, port 587,
# its full Gmail address, and a Google app password (requires 2-Step Verification).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASSWORD=replace-with-smtp-password-or-app-password
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=Rosario Dairy <sender@example.com>

# Forecast evaluation runs offline, separately from report refresh requests.
# Schedule at 00:00 Asia/Manila: python manage.py watch_forecast_models --once
# This runs the tracked patterns/model/projection/evidence workflow.
# API/PDF requests only read saved results; use the deployment timer in forecasting/deploy/.
# No files are exported unless --output /private/path is supplied.
# Read payloads expire after five minutes; committed business writes invalidate them.
API_DATA_CACHE_TIMEOUT=300
# History payloads stay warm for an hour; committed writes still invalidate them.
HISTORY_CACHE_TIMEOUT=3600

# Refresh responses rotate the refresh token. Clients must save both returned
# tokens. Logout invalidates all access/refresh tokens for the account.
# Recovery-email changes: POST then PATCH /accounts/email-change/ with the
# current password and the emailed verification code. See README.md.
