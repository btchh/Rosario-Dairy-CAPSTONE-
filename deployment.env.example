# Copy these names into your hosting provider's secret/environment settings.
# Never commit the real values.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_TIME_ZONE=Asia/Manila

DB_NAME=rosario_dairy
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_HOST=replace-me
DB_PORT=5432
# Per-host connection establishment timeout; does not limit query execution.
DB_CONNECT_TIMEOUT=5
# Copy the complete URL supplied by the managed Redis provider.
REDIS_URL=rediss://username:password@redis-host.example.com:6379/0

CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_BEHIND_HTTPS_PROXY=true
# Set to 0 for direct access. Otherwise set the actual trusted proxy hop count,
# overwrite client-supplied forwarding headers at the edge, and firewall direct
# access to the application. The backend defaults to ignoring forwarded headers.
DJANGO_NUM_PROXIES=1
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Any SMTP provider works. For a Gmail sender, use smtp.gmail.com, port 587,
# its full Gmail address, and a Google app password (requires 2-Step Verification).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=sender@example.com
SMTP_PASSWORD=replace-with-smtp-password-or-app-password
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=Rosario Dairy <sender@example.com>

# Forecast evaluation runs offline, separately from report refresh requests.
# Schedule at 00:00 Asia/Manila: python manage.py watch_forecast_models --once
# This runs the tracked patterns/model/projection/evidence workflow.
# API/PDF requests only read saved results; use the deployment timer in forecasting/deploy/.
# No files are exported unless --output /private/path is supplied.
# Read payloads expire after five minutes; committed business writes invalidate them.
API_DATA_CACHE_TIMEOUT=300
# History payloads stay warm for an hour; committed writes still invalidate them.
HISTORY_CACHE_TIMEOUT=3600

# Refresh responses rotate the refresh token. Clients must save both returned
# tokens. Logout invalidates all access/refresh tokens for the account.
# Recovery-email changes: POST then PATCH /accounts/email-change/ with the
# current password and the emailed verification code. See README.md.
