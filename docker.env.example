# Local Docker stack only. Copy to .env.docker and replace both placeholders.
# The database starts empty in its own Docker volume.
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DB_PASSWORD=replace-with-a-local-database-password
DB_NAME=rosario_dairy
DB_USER=rosario_local
# Human inactivity deadline and frontend warning lead time, in seconds.
AUTH_IDLE_TIMEOUT_SECONDS=900
AUTH_IDLE_WARNING_SECONDS=60
API_PORT=8000
# Use 5174 while a native Vite server is still using 5173.
FRONTEND_PORT=5173
# Build source for docker/compose.frontend.build.yaml, relative to this directory.
FRONTEND_SOURCE=../SarimaHoesButFrontend
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
